  <project name="developtools_integration_verification" path="developtools/integration_verification"/>
  <project name="interface_sdk_c" path="interface/sdk_c"/>
  <project name="third_party_musl" path="third_party/musl"/>
  <project name="hiviewdfx_hisysevent" path="base/hiviewdfx/hisysevent"/>

  <project name="hiviewdfx_faultloggerd" path="base/hiviewdfx/faultloggerd"/>
  <project name="startup_init" path="base/startup/init"/>
  <project name="hiviewdfx_hitrace" path="base/hiviewdfx/hitrace"/>
  <project name="hiviewdfx_hiview" path="base/hiviewdfx/hiview"/>


  
  <remote fetch="https://github.com/notrobot1" name="fork"/>
  <project name="arkui_ace_engine" path="foundation/arkui/ace_engine"
           remote="fork" revision="main"/>
  <project name="arkcompiler_ets_runtime" path="arkcompiler/ets_runtime"
           remote="fork" revision="main"/>

  <!--
    NOT included: everything needed to package the previewer SDK itself
    (out/sdk/ohos-sdk/linux/previewer/common with its .abc modules, mock
    system APIs, fonts and system resources). We consume that directory at
    runtime but do not rebuild it. If you want to build it from source, add
    at least these and re-run the collection script against the SDK targets:

      interface/sdk-js
      commonlibrary/ets_utils
      developtools/ace_ets2bundle
      developtools/ace_js2bundle
      developtools/packing_tool
      developtools/global_resource_tool
      arkcompiler/toolchain
      foundation/multimedia/image_framework

    Verify the exact repository names before adding, e.g.:
      grep -rn 'path="interface/sdk-js"' .repo/manifests/ohos/
  -->
</manifest>
