<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal OpenHarmony manifest for the arkVM2 project (GitHub mirror).
  Branch: OpenHarmony-7.0-Release

  Covers exactly the repositories required to build:
    clang_x64/arkui/ace_engine/libace_compatible.so
    clang_x64/arkui/ace_engine/libarkui_button.so
    clang_x64/arkcompiler/ets_runtime/libark_jsruntime.so
    clang_x64/window/window_manager/libpreviewer_window.so
    clang_x64/graphic/graphic_2d/libglfw_render_context.so

  Derived from `ninja -t commands` of those targets, mapped onto
  .repo/manifests/ohos/ohos.xml by longest prefix match.

  Usage:
    repo init -u <this manifest repo> -b main -m arkvm-manifest.xml
    repo sync -c -j8
    ./build/prebuilts_download.sh

  Toolchains (clang, ninja, node) are fetched by prebuilts_download.sh,
  not by repo.

  Note for editors of this file: XML comments may not contain a double
  hyphen, so command line flags are written without their leading dashes.
-->
<manifest>
  <remote fetch="https://github.com/openharmony" name="github"/>
  <remote fetch="https://gitee.com/openharmony" name="origin"
          review="https://openharmony.gitee.com/openharmony/"/>
  <remote fetch="https://gitcode.com/openharmony" name="gitcode"
          review="https://gitcode.com/openharmony/"/>
  <default remote="github" revision="OpenHarmony-7.0-Release" sync-j="4"/>

  <!-- build system -->
  <project name="build" path="build"/>

  <!-- product configuration: read by GN, never appears in compile commands,
       but the build cannot be configured without it -->
  <project name="productdefine_common" path="productdefine/common"/>

  <!-- ARK: bytecode runtime, frontend, core -->
  <project name="arkcompiler_ets_frontend" path="arkcompiler/ets_frontend"/>
  <!-- <project name="arkcompiler_ets_runtime" path="arkcompiler/ets_runtime"/> -->
  <project name="arkcompiler_runtime_core" path="arkcompiler/runtime_core"/>

  <!-- ArkUI -->
  <!-- <project name="arkui_ace_engine" path="foundation/arkui/ace_engine"/> -->
  <project name="arkui_napi" path="foundation/arkui/napi"/>

  <!-- graphics and windowing -->
  <project name="graphic_graphic_2d" path="foundation/graphic/graphic_2d"/>
  <project name="graphic_graphic_surface" path="foundation/graphic/graphic_surface"/>
  <project name="graphic_graphics_effect" path="foundation/graphic/graphics_effect"/>
  <project name="window_window_manager" path="foundation/window/window_manager"/>
  <project name="ide_previewer" path="ide/tools/previewer"/>

  <!-- headers pulled in by ace_engine -->
  <project name="ability_ability_runtime" path="foundation/ability/ability_runtime"/>
  <project name="bundlemanager_bundle_framework" path="foundation/bundlemanager/bundle_framework"/>

  <!-- base libraries -->
  <!-- <project name="global_i18n_standard" path="base/global/i18n" revision="master"/> -->
  <project name="global_resource_management" path="base/global/resource_management"/>
  <project name="hiviewdfx_hilog" path="base/hiviewdfx/hilog"/>
  <project name="commonlibrary_c_utils" path="commonlibrary/c_utils"/>
  <project name="commonlibrary_qrcode_generator" path="commonlibrary/qrcode_generator"/>

  <!-- third party -->
  <project name="third_party_egl" path="third_party/EGL"/>
  <project name="third_party_opengles" path="third_party/openGLES"/>
  <project name="third_party_abseil-cpp" path="third_party/abseil-cpp"/>
